# Copy this file to .env (same directory) and fill in your values.
# .env is auto-loaded by config.py via python-dotenv.

# ============================================================================
# Nominatim (OSM geocoding) — REQUIRED for get_user_location
# Their usage policy requires an identifying User-Agent. Use your real contact.
# Policy: https://operations.osmfoundation.org/policies/nominatim/
# ============================================================================
NOMINATIM_UA=AgentClaw/1.0 (your-email@example.com)

# ============================================================================
# Overpass (OSM restaurant search) — public mirror is fine; self-host for volume
# ============================================================================
OVERPASS_URL=https://overpass-api.de/api/interpreter

# ============================================================================
# Cal.com (real booking backend) — REQUIRED for check_availability + book_reservation
# Cloud:   CALCOM_BASE_URL=https://api.cal.com
# Self-host: CALCOM_BASE_URL=https://your-calcom.example.com
# Get an API key from /settings/developer/api-keys
# Get the EVENT_TYPE_ID from the URL of your event type in Cal.com
# ============================================================================
CALCOM_BASE_URL=https://api.cal.com
CALCOM_API_KEY=cal_live_XXXXXXXXXXXXXXXXXXXXXXXX
CALCOM_EVENT_TYPE_ID=123456
# Pinned API versions per Cal.com docs (do not change unless docs change):
CALCOM_API_VERSION_SLOTS=2024-09-04
CALCOM_API_VERSION_BOOKINGS=2024-08-13
ATTENDEE_NAME=Agent Guest
ATTENDEE_EMAIL=guest@example.com
TZ=Asia/Kolkata

# ============================================================================
# Twilio (real SMS) — REQUIRED for send_sms
# Trial accounts: can send only to VERIFIED numbers; messages include a trial prefix.
# US local numbers require A2P 10DLC registration.
# ============================================================================
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
# Optional: a public URL to receive delivery status callbacks
TWILIO_STATUS_CALLBACK=

# ============================================================================
# Planner choice — pick ONE if you want LLM-driven; rule planner needs nothing.
# ============================================================================

# Local Ollama (free) — install Ollama, then `ollama pull qwen2.5` (or llama3.1 / mistral)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# ============================================================================
# Restaurant data source
#
# 'osm'       (default) — free, fast, name-only restaurant list from
#                          OpenStreetMap via Overpass. Returns lat/lng and
#                          distance from the geocoded address.
# 'eazydiner' — Playwright scrape of EazyDiner's city listing page. Returns
#                          real names, ratings, cuisines, prices, locality
#                          and the EazyDiner URL. The Cal.com booking still
#                          happens; the SMS gives the user the EazyDiner URL
#                          to finalize the actual reservation themselves.
#
# eazydiner requires: pip install playwright && python -m playwright install chromium
# ============================================================================
RESTAURANT_SOURCE=eazydiner
# Optional EazyDiner tuning:
EAZYDINER_HEADLESS=true       # set 'false' to watch the browser for debugging
EAZYDINER_PAGES=1             # 1 = first page (~9 restaurants); raise for more
EAZYDINER_CACHE_MIN=60        # cache per-city scrape for N minutes

# Anthropic Claude (paid) — only needed for --planner claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-7

# ============================================================================
# Google Calendar — OPTIONAL (calendar event is skipped gracefully if unset)
#
# Setup (one time):
#   1. https://console.cloud.google.com/  → create or pick a project.
#   2. APIs & Services → Library → enable "Google Calendar API".
#   3. APIs & Services → OAuth consent screen → User Type: External (personal
#      Google account) or Internal (Workspace). Add scope
#      .../auth/calendar.events. Add your Google email under Test users.
#   4. APIs & Services → Credentials → Create credentials → OAuth client ID
#      → Application type: Desktop app. Download the JSON.
#   5. Save the downloaded file as data/client_secret.json (or anywhere) and
#      set GOOGLE_CLIENT_SECRETS_PATH below to its path. Relative paths
#      resolve against the project root (Restaurant-claw/).
#   6. Run: python -m agent_claw --gcal-setup
#      A browser opens, you consent, refresh token is saved to
#      GOOGLE_TOKEN_PATH (default: data/google_token.json).
#
# For Google Workspace + service account (no browser consent), see the
# comment block at the bottom of providers/calendar.py.
# ============================================================================
GOOGLE_CLIENT_SECRETS_PATH=data/client_secret.json
GOOGLE_TOKEN_PATH=data/google_token.json
GOOGLE_CALENDAR_ID=primary
# Popup reminders, in minutes BEFORE the event start. Comma-separated.
# Default: 1 hour and 1 day before.
GOOGLE_REMINDER_MINUTES=60,1440
# Event block length (Cal.com only knows the start time).
GOOGLE_EVENT_DURATION_MIN=90

# ============================================================================
# HTTP client tuning (optional)
# ============================================================================
HTTP_TIMEOUT_S=30
HTTP_RETRIES=3

# ============================================================================
# Email (Gmail SMTP) — REQUIRED for send_email (customer + restaurant confirmations)
#
# SMTP_USER must be a Gmail address with 2-Step Verification ENABLED.
# SMTP_APP_PASSWORD is a 16-char Gmail *App Password* (NOT your login password):
#   Google Account -> Security -> 2-Step Verification (ON)
#   -> App passwords -> generate for "Mail" -> paste the 16 chars below.
# Spaces in the app password are fine; the code strips them.
# ============================================================================
SMTP_USER=kalaivanimanickam865@gmail.com
SMTP_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_FROM_NAME=Agent-Claw Reservations

# Who receives the two confirmation emails (sent on every successful booking).
CUSTOMER_EMAIL=nishanthini01ai@gmail.com
RESTAURANT_EMAIL=kalaivanimanickam865@gmail.com
